{
  "name": "thinkso",
  "version": "0.0.0",
  "private": true,
  "description": "ThinkSo workspace tooling",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check": "just check",
    "lint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern 'apps/mobile/**/*.{js,jsx,ts,tsx}' 'packages/**/*.{js,jsx,ts,tsx}'",
    "typecheck": "node scripts/run-typecheck.mjs",
    "test": "node scripts/run-tests.mjs",
    "hygiene": "node scripts/hygiene.mjs",
    "links:check": "node scripts/check-markdown-links.mjs",
    "openapi:check": "node scripts/check-openapi.mjs",
    "openapi:generate": "uv run --locked --directory services/api python scripts/generate_openapi.py && pnpm --filter @thinkso/api-client generate && pnpm exec prettier --write services/api/openapi.json packages/api-client/src/generated.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
