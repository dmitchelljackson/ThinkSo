# Safe names and local defaults only. Copy to ignored .env.local; never add secrets here.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://thinkso:local-development-only@localhost:5432/thinkso
LOG_LEVEL=INFO

# Firebase Authentication. Production uses Application Default Credentials or
# an ignored service-account path; local tests point the Admin SDK at the emulator.
FIREBASE_PROJECT_ID=thinkso-5768a
FIREBASE_AUTH_EMULATOR_HOST=
GOOGLE_APPLICATION_CREDENTIALS=

# Agent provider and locked default policy
OPENROUTER_API_KEY=
MINTING_MODEL_ID=z-ai/glm-5.3-flash
JUDGING_MODEL_ID=z-ai/glm-5.3-flash
UNLIMITED_AGENT_EMAILS=
MINTING_DAILY_BUDGET_USD=0.25
JUDGING_CONTRACT_BUDGET_USD=1.00
OPENROUTER_DAILY_BUDGET_USD=25.00

# Threads authorization and encrypted token storage
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_OAUTH_REDIRECT_URI=
THREADS_TEST_HANDLE=
THREADS_TOKEN_ENCRYPTION_KEY=

# Expo Push Service
EXPO_PUSH_ACCESS_TOKEN=
